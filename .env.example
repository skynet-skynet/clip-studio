# Скопируйте в .env и заполните только то, чем пользуетесь. Файл .env не коммитится.

# Anthropic API — только для режима llm.mode: api
ANTHROPIC_API_KEY=

# VK: ключ пользователя с правом video (получение — в GUIDE.md, раздел «VK»)
VK_ACCESS_TOKEN=
# ID приложения VK ID — нужен только для встроенной авторизации кнопкой в GUI
VK_CLIENT_ID=

# YouTube Data API key — только для поиска CC BY видео (загрузка идёт через OAuth, см. GUIDE.md)
YOUTUBE_API_KEY=

# Telegram: токен бота от @BotFather (бот должен быть админом канала)
TELEGRAM_BOT_TOKEN=
